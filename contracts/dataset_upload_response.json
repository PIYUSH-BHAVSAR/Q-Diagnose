{
  "_comment": "FROZEN CONTRACT v1.0 — Phase 1 output / Phase 2 input / Frontend input",
  "_description": "Shape returned by POST /api/datasets/upload on successful registration.",
  "_producer": "Phase 1 Ingestion (Shweta — api/datasets.py)",
  "_consumers": ["Phase 2 Profiler (Jayed)", "Frontend (Naeem)", "Experiment Manager (Piyush)"],
  "_status": "FROZEN — any change requires team ping before merging",

  "dataset_id": {
    "_description": "Internal UUID — primary key for all downstream references",
    "_type": "string (UUID v4)",
    "_example": "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5a6b7"
  },
  "display_id": {
    "_description": "Human-readable ID shown in the UI",
    "_type": "string",
    "_example": "DS-000001",
    "_format": "DS-{6-digit zero-padded counter}"
  },
  "status": {
    "_description": "Registration outcome",
    "_type": "string (enum)",
    "_values": ["REGISTERED", "REJECTED"],
    "_example": "REGISTERED"
  },
  "filename": {
    "_description": "Original filename as uploaded by the user",
    "_type": "string",
    "_example": "breast_cancer.csv"
  },
  "container_type": {
    "_description": "File/container format detected by Phase 1 (NOT the ML modality)",
    "_type": "string (enum)",
    "_values": ["CSV", "XLSX", "ZIP"],
    "_example": "CSV"
  },
  "upload_timestamp": {
    "_description": "UTC time when the dataset was registered",
    "_type": "ISO 8601 datetime string",
    "_example": "2026-09-10T14:23:45.123Z"
  },
  "file_size_bytes": {
    "_description": "Raw file size in bytes",
    "_type": "integer",
    "_example": 125847
  },
  "sha256": {
    "_description": "Hex-encoded SHA-256 hash of the raw uploaded bytes. Used for duplicate detection.",
    "_type": "string (64 hex chars)",
    "_example": "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890"
  },
  "storage_path": {
    "_description": "Relative path to the immutable raw file from the storage base directory",
    "_type": "string",
    "_example": "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5a6b7/raw/original.csv"
  },
  "is_duplicate": {
    "_description": "True if an identical SHA-256 already exists in the registry. Duplicate is NOT an error — returns 201.",
    "_type": "boolean",
    "_example": false
  },
  "duplicate_of": {
    "_description": "dataset_id of the previously registered identical file. null when is_duplicate=false.",
    "_type": "string (UUID) or null",
    "_example": null
  },
  "validation_warnings": {
    "_description": "Non-blocking warnings from format/archive validation (e.g. unusual MIME type)",
    "_type": "array of strings",
    "_example": []
  },
  "rejection_reason": {
    "_description": "Human-readable reason when status=REJECTED. null when status=REGISTERED.",
    "_type": "string or null",
    "_example": null
  },

  "_example_breast_cancer": {
    "dataset_id":          "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5a6b7",
    "display_id":          "DS-000001",
    "status":              "REGISTERED",
    "filename":            "breast_cancer.csv",
    "container_type":      "CSV",
    "upload_timestamp":    "2026-09-10T14:23:45.123Z",
    "file_size_bytes":     125847,
    "sha256":              "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890",
    "storage_path":        "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5a6b7/raw/original.csv",
    "is_duplicate":        false,
    "duplicate_of":        null,
    "validation_warnings": [],
    "rejection_reason":    null
  },

  "_example_heart_disease": {
    "dataset_id":          "b2c3d4e5-f6a7-4890-b1c2-d3e4f5a6b7c8",
    "display_id":          "DS-000002",
    "status":              "REGISTERED",
    "filename":            "heart_disease.csv",
    "container_type":      "CSV",
    "upload_timestamp":    "2026-09-10T15:10:00.000Z",
    "file_size_bytes":     18624,
    "sha256":              "b2c3d4e5f6a78901bcdef23456789012bcdef23456789012bcdef23456789012",
    "storage_path":        "b2c3d4e5-f6a7-4890-b1c2-d3e4f5a6b7c8/raw/original.csv",
    "is_duplicate":        false,
    "duplicate_of":        null,
    "validation_warnings": [],
    "rejection_reason":    null
  },

  "_example_duplicate": {
    "dataset_id":          "c3d4e5f6-a7b8-4901-c2d3-e4f5a6b7c8d9",
    "display_id":          "DS-000003",
    "status":              "REGISTERED",
    "filename":            "breast_cancer.csv",
    "container_type":      "CSV",
    "upload_timestamp":    "2026-09-10T16:00:00.000Z",
    "file_size_bytes":     125847,
    "sha256":              "a1b2c3d4e5f67890abcdef1234567890abcdef1234567890abcdef1234567890",
    "storage_path":        "c3d4e5f6-a7b8-4901-c2d3-e4f5a6b7c8d9/raw/original.csv",
    "is_duplicate":        true,
    "duplicate_of":        "a1b2c3d4-e5f6-4789-a0b1-c2d3e4f5a6b7",
    "validation_warnings": [],
    "rejection_reason":    null
  }
}
