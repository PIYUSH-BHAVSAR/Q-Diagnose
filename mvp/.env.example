# Application
APP_NAME=QuantWarriors-QML
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./quantwarriors.db

# Paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACTS_DIR=./artifacts

# Quantum Configuration
QUANTUM_MAX_QUBITS=8
QUANTUM_LAYERS=2
QUANTUM_SHOTS=1024

# Feature Reduction
PCA_CANDIDATE_DIMENSIONS=[4,8]

# Experiment
RANDOM_STATE=42
TEST_SIZE=0.2
MAX_RUNTIME_SECONDS=300
